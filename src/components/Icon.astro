---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 16 } = Astro.props;

// Minimal inline icons (stroke-based, feather-style). Add a case here
// to use a new icon.
const icons: Record<string, string> = {
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>',
};

const paths = icons[name] ?? icons.moon;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
