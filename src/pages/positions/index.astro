---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const positions = await getCollection('positions');
const typeOrder = { internship: 0, phd: 1, postdoc: 2 } as Record<string, number>;
const open = positions
  .filter((p) => p.data.status === 'open')
  .sort((a, b) => (typeOrder[a.data.type] ?? 3) - (typeOrder[b.data.type] ?? 3) || a.data.title.localeCompare(b.data.title));
const filled = positions
  .filter((p) => p.data.status === 'filled')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title={`Open positions — Yassine Mhiri`}>
  <article>
    <h1>Open positions</h1>

    {
      open.length > 0 ? (
        open.map((p) => (
          <a class="position-card" href={`/positions/${p.id}/`}>
            <p class="position-card__title">
              {p.data.title} <span class="badge">{p.data.type}</span>
            </p>
            <p class="position-card__meta">
              {p.data.duration && <span>{p.data.duration}</span>}
              {p.data.location && <span>· {p.data.location}</span>}
              {p.data.deadline && <span>· apply before {p.data.deadline}</span>}
            </p>
            {p.data.summary && <p class="position-card__summary">{p.data.summary}</p>}
          </a>
        ))
      ) : (
        <p>There are currently no open positions. Check back later or reach out by email.</p>
      )
    }

    {filled.length > 0 && (
      <section>
        <h2>Past positions</h2>
        <ul>
          {filled.map((p) => (
            <li>
              <a href={`/positions/${p.id}/`}>{p.data.title}</a>{' '}
              <span class="badge badge--muted">filled</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
